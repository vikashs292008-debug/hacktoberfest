# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
env/
venv/
ENV/
*.egg-info/

# Node / Frontend
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Environment Secrets (NEVER COMMIT KEYS)
.env
*.env
backend/.env
frontend/.env
frontend/.env.*.local
!.env.example
!backend/.env.example

# Local SQLite databases & test runtime artifacts
data/*.db
data/*.sqlite
data/*.sqlite3
data/datasets/*.parquet
data/mock_state/*.json
!data/datasets/.gitkeep
!data/mock_state/.gitkeep
!data/reports/.gitkeep

# Operating System
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
